# Environment variables for Errand Concierge.
# Copy to `.env` and fill in what you need. Every value is optional: with no
# model key the app runs in a fully usable demo mode.

# --- Core -------------------------------------------------------------------
# Force the deterministic demo assistant even if a model key is present.
DEMO_MODE=false

# SQLite file. A relative path is resolved against the project root.
DATABASE_PATH=./data/errands.db

# Signs the OAuth `state` parameter. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=

# Comma-separated list of extra origins allowed to call the API
# (only needed when the frontend is hosted separately, e.g. Vercel).
ALLOWED_ORIGINS=

# Where to send the browser after a Google OAuth round-trip when the frontend
# is hosted separately. Leave blank to use the API's own origin.
FRONTEND_URL=

# Used to place calendar events and to interpret "today"/"tomorrow".
CALENDAR_TIMEZONE=Africa/Lagos

# Conversational memory lifetime per browser session.
SESSION_TTL_HOURS=12
MAX_SESSIONS=200
MAX_MESSAGE_CHARS=4000

# --- Model (AWS Bedrock Mantle, OpenAI-compatible) --------------------------
BEDROCK_API_KEY=
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_MODEL_ID=openai.gpt-oss-120b

# --- Google Calendar (optional) --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# --- Server -----------------------------------------------------------------
PORT=8000
